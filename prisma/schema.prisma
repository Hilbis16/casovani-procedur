generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth / User management (Wave A) ─────────────────────────────────────────

model Facility {
  id        String   @id @default(cuid())
  name      String
  ico       String?
  address   String?
  contact   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("facilities")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime?
  passwordHash    String?
  fullName        String
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles     UserRole[]
  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

model Role {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  permissions Permission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id     String @id @default(cuid())
  roleId String
  action String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, action])
  @@map("permissions")
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?
  actorIp    String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  meta       Json?
  occurredAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([occurredAt])
  @@index([entity, entityId])
  @@index([actorId, occurredAt])
  @@map("audit_logs")
}

// ─── Clinical domain (Wave B) ─────────────────────────────────────────────────

model Building {
  id    String @id @default(cuid())
  code  String @unique
  name  String

  rooms Room[]

  @@map("buildings")
}

// kind: patient_room | procedure_room | office
model Room {
  id         String  @id @default(cuid())
  buildingId String
  number     String
  floor      Int?
  capacity   Int     @default(1)
  kind       String  @default("patient_room")
  isActive   Boolean @default(true)

  building  Building            @relation(fields: [buildingId], references: [id])
  stays     Stay[]
  schedules ProcedureSchedule[]

  @@unique([buildingId, number])
  @@index([kind])
  @@map("rooms")
}

model Patient {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  note      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stays     Stay[]
  schedules ProcedureSchedule[]

  @@index([deletedAt])
  @@index([lastName])
  @@map("patients")
}

// status: planned | checked_in | checked_out | cancelled
model Stay {
  id            String    @id @default(cuid())
  code          String    @unique
  patientId     String
  roomId        String?
  arrivalDate   DateTime
  departureDate DateTime
  status        String    @default("planned")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  patient   Patient             @relation(fields: [patientId], references: [id])
  room      Room?               @relation(fields: [roomId], references: [id])
  schedules ProcedureSchedule[]

  @@index([patientId, status])
  @@index([deletedAt])
  @@map("stays")
}

model Therapist {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  phone     String?
  color     String   @default("#3B82F6")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilities TherapistAvailability[]
  timeOffs       TherapistTimeOff[]
  schedules      ProcedureSchedule[]

  @@map("therapists")
}

model TherapistAvailability {
  id          String @id @default(cuid())
  therapistId String
  dayOfWeek   Int
  startTime   String @default("08:00")
  endTime     String @default("16:00")

  therapist Therapist @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@map("therapist_availabilities")
}

model TherapistTimeOff {
  id          String   @id @default(cuid())
  therapistId String
  startsAt    DateTime
  endsAt      DateTime
  reason      String?

  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@index([therapistId, startsAt])
  @@map("therapist_time_offs")
}

model Procedure {
  id          String  @id @default(cuid())
  name        String
  category    String
  durationMin Int
  description String?
  room        String?
  building    String?
  isActive    Boolean @default(true)

  schedules ProcedureSchedule[]

  @@map("procedures")
}

// status: planned | confirmed | completed | cancelled | no_show
model ProcedureSchedule {
  id              String    @id @default(cuid())
  stayId          String
  patientId       String
  procedureId     String
  therapistId     String
  procedureRoomId String?
  date            DateTime
  startTime       String
  endTime         String
  note            String?
  status          String    @default("planned")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  stay          Stay      @relation(fields: [stayId], references: [id])
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  procedure     Procedure @relation(fields: [procedureId], references: [id])
  therapist     Therapist @relation(fields: [therapistId], references: [id])
  procedureRoom Room?     @relation(fields: [procedureRoomId], references: [id])

  @@index([patientId, date])
  @@index([therapistId, date])
  @@index([procedureRoomId, date])
  @@index([stayId])
  @@index([deletedAt])
  @@map("procedure_schedules")
}
