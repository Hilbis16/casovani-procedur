# ─────────────────────────────────────────────────────────────────────────────
# Required for all environments
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://lazenska:secret@localhost:5432/lazenska_dev?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# Added in Phase 1 — Authentication
# ─────────────────────────────────────────────────────────────────────────────

# Auth.js v5 secret — generate with: openssl rand -base64 32
# AUTH_SECRET=

# Application URL (used for OAuth callbacks, email links)
# NEXTAUTH_URL=http://localhost:3002

# ─────────────────────────────────────────────────────────────────────────────
# Added in Phase 5 — Field-level encryption
# ─────────────────────────────────────────────────────────────────────────────

# AES-256-GCM key for prisma-field-encryption — generate with: openssl rand -base64 32
# Changing this key requires re-encrypting all encrypted fields (see docs/RUNBOOK.md)
# ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Added in Phase 8 — Optional integrations
# ─────────────────────────────────────────────────────────────────────────────

# Sentry DSN (self-hosted Sentry; leave empty to disable error tracking)
# SENTRY_DSN=

# MinIO / S3-compatible storage (for PDF export and report storage)
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=lazenska

# ─────────────────────────────────────────────────────────────────────────────
# First-run admin seed (Phase 1)
# ─────────────────────────────────────────────────────────────────────────────

# Used by prisma/seed.ts to create the initial OPERATOR account
# SEED_ADMIN_EMAIL=admin@facility.example
# SEED_ADMIN_PASSWORD=
